  "projects": {
    "THE_TRAP": {
      "identity": {
        "project_id": "THE_TRAP",
        "project_prefix": "ttm",
        "project_group": "standard"
      },
      "dcc": {
        "default": "blender",
        "blender": {
          "scene_extensions": [
            ".blend"
          ],
          "work_dirs": [
            "ren",
            "cfx",
            "fx"
          ]
        }
      },
      "paths": {
        "project_root": "T:/",
        "asset_root": "T:/assets",
        "scene_root": "T:/scenes",
        "json_root": "T:/",
        "output_root": "T:/output",
        "render_preset_json": "T:/_json/renderPreset.json",
        "render_setting_json": "T:/_json/renderSetting.json"
      },
      "scene_browser": {
        "levels": [
          {
            "id": "scene",
            "label": "Scene",
            "root_path": "T:/scenes",
            "path_mode": "children"
          },
          {
            "id": "cut",
            "label": "Cut",
            "parent_level": "scene",
            "path_mode": "children"
          },
          {
            "id": "work",
            "label": "Work",
            "parent_level": "cut",
            "fixed_options": [
              "ren",
              "cfx",
              "fx"
            ],
            "default": "ren"
          }
        ],
        "file_level_id": "work",
        "file_extensions": [
          ".blend"
        ]
      },
      "scene_structure": {
        "identifier_source": "folder_depth",
        "scene_level_id": "scene",
        "cut_level_id": "cut",
        "work_level_id": "work",
        "cache_path_mode": "relative_to_work",
        "cache_relative_path": "cache"
      },
      "assets": {
        "categories": [
          {
            "id": "ch",
            "label": "Character",
            "root_path": "T:/assets/ch",
            "publish_file_mode": "asset_mod_blend",
            "publish_file_template": "{root}/{asset_name}/mod/{asset_name}.blend",
            "asset_id_source": "folder_name",
            "geometry_root_hint": "geo"
          },
          {
            "id": "bg",
            "label": "Background",
            "root_path": "T:/assets/bg",
            "publish_file_mode": "asset_mod_blend",
            "publish_file_template": "{root}/{asset_name}/mod/{asset_name}.blend",
            "asset_id_source": "folder_name",
            "geometry_root_hint": "geo"
          },
          {
            "id": "prop",
            "label": "Prop",
            "root_path": "T:/assets/prop",
            "publish_file_mode": "asset_mod_blend",
            "publish_file_template": "{root}/{asset_name}/mod/{asset_name}.blend",
            "asset_id_source": "folder_name",
            "geometry_root_hint": "geo"
          }
        ],
        "asset_id_rules": {
          "normalize_case": "lower",
          "replace_spaces_with": "_",
          "strip_tokens": [
            "rig",
            "mod",
            "pub",
            "fin",
            "final"
          ],
          "strip_numeric_suffix": true
        }
      },
      "cache": {
        "root_mode": "relative_to_work",
        "root_template": "{work_path}/cache",
        "file_template": "{project_prefix}_{scene}_{cut}_{category}_{asset_id}.usd",
        "match_mode": "by_asset_id_and_category",
        "extensions": [
          ".usd"
        ]
      },
      "output": {
        "root_template": "T:/output/ren/{scene}/{scene}_{cut}",
        "version_folder_mode": "v###",
        "default_version_digits": 3,
        "file_slot_prefix_template": "{scene}_{cut}_{layer}_"
      },
      "overrides": {
        "asset_registry": [],
        "cache_overrides": []
      }
    },
